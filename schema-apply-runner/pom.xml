<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>schema-apply-runner</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Schema Apply Runner</name>
    <description>
        Spec X (plane-based migration). A generic Spring Boot + Liquibase bootstrap
        that APPLIES a generated DB migration pack changelog to a target database
        during startup, filtered by Liquibase contexts (structural | post-load), so
        the data-migration runner (Spec Y) can run between the two schema phases.
        Engine-agnostic: it applies whatever changelog it is pointed at — all
        source/target engine specifics live in the generated pack content, never here.
    </description>

    <properties>
        <java.version>21</java.version>
        <!-- H2 pin matches architecture-model-service: 2.3.x accepts the wider DDL
             surface in PostgreSQL mode. Test scope only (the real target is
             PostgreSQL via the runtime driver below). -->
        <h2.version>2.3.232</h2.version>
    </properties>

    <dependencies>
        <!-- JDBC + connection pool (HikariCP) + Spring DataSource autoconfig. NO web. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Liquibase: the same migration engine a real Spring target app uses. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- Target driver (PostgreSQL 18). Runtime only — swap/add drivers to
             target other engines; the runner code never names an engine. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
