# Gateway Chat Orchestrator Configuration
# Copy this file to .env and adjust values as needed

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# OpenAI API key (REQUIRED - no default)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ============================================================================
# LLM PROVIDER SELECTION
# ============================================================================

# Which LLM provider to use: 'openai' or 'azure-openai'
# Default: openai
LLM_PROVIDER=openai

# ============================================================================
# OPENAI CONFIGURATION (when LLM_PROVIDER=openai)
# ============================================================================

# OpenAI model to use for chat completions
# Default: gpt-4o
OPENAI_MODEL=gpt-5

# OpenAI API base URL (change for proxies)
# Default: https://api.openai.com/v1
/OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI request timeout in milliseconds
# Default: 1200000 (20 minutes)
OPENAI_TIMEOUT_MS=1200000

# ============================================================================
# AZURE OPENAI CONFIGURATION (when LLM_PROVIDER=azure-openai)
# ============================================================================

# Azure AD / OAuth token endpoint for authentication
AZURE_AUTH_ENDPOINT=https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/token

# Azure API credentials (service principal or app registration)
AZURE_API_USERNAME=your-client-id
AZURE_API_PASSWORD=your-client-secret

# Azure OpenAI chat completions endpoint
AZURE_CHAT_ENDPOINT=https://{resource-name}.openai.azure.com/openai/deployments/{deployment-name}/chat/completions

# Azure OpenAI API version
AZURE_API_VERSION=2024-08-01-preview

# Azure OpenAI model/deployment name
AZURE_API_MODEL=gpt-4o

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================

# MCP server base URL for tool execution
# Default: http://localhost:8090
MCP_BASE_URL=http://localhost:8090

# ============================================================================
# IMPLEMENTATION LLM PROXY SERVICE
# ============================================================================

# Spec 2026-02-01: Unify Implementation LLM Proxy Service Config
# All calls to standards, orchestrations, and shape-spec endpoints use these variables.
# This service runs at localhost:8000 and handles implementation-related LLM requests.

# Base URL for the Implementation LLM Proxy service
# Default: http://localhost:8000
IMPLEMENTATION_LLM_SERVICE_BASE_URL=http://localhost:8000

# Bearer token for Implementation LLM Proxy service authentication (REQUIRED)
# Required for Gateway to communicate with the Implementation LLM Proxy service.
# This token is injected as Authorization header for all upstream requests.
# Leave empty to disable (will fail at request time with 500 error)
IMPLEMENTATION_LLM_SERVICE_BEARER_TOKEN=changeit

# ============================================================================
# JIRA SERVICE CONFIGURATION
# ============================================================================

# Base URL for the Jira integration service (Spring Boot)
# Proxied at GET /api/v1/jira/issues
# Default: http://localhost:8078
JIRA_SERVICE_URL=http://localhost:8078

# ============================================================================
# GATEWAY SERVER CONFIGURATION
# ============================================================================

# Gateway server port
# Default: 8081
PORT=8081

# Maximum tool calls allowed per conversation turn (prevents infinite loops)
# Default: 8
MAX_TOOL_CALLS_PER_TURN=8

# Maximum OAS content size in bytes (2MB default)
# Default: 2097152
MAX_OAS_BYTES=2097152

# Maximum user message size in bytes (32KB default)
# Default: 32768
MAX_MESSAGE_BYTES=32768

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit: requests per minute per IP
# Default: 300
RATE_LIMIT_RPM=300

# Rate limit: burst allowance (extra requests allowed in burst)
# Default: 20
RATE_LIMIT_BURST=20

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================

# Session time-to-live in hours (sessions expire after this time of inactivity)
# Default: 24
SESSION_TTL_HOURS=24

# ============================================================================
# LOGGING
# ============================================================================

# Log level: error, warn, info, http, verbose, debug, silly
# Default: info
LOG_LEVEL=info

# ============================================================================
# SECURITY
# ============================================================================

# CORS allowed origins (comma-separated list)
# Default: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# DEBUG OPTIONS
# ============================================================================

# Include tool trace in responses (useful for debugging)
# Default: false
ENABLE_TOOL_TRACE=false

# ============================================================================
# MIGRATION DELIVERY PLAN GENERATION
# ============================================================================

# Spec 2026-06-11: Two-Phase Migration Delivery Plan Generation (Skeleton -> Expand)

# Maximum concurrent in-flight LLM requests across ALL migration-plan calls.
# Phase-1 per-stream skeleton calls AND every phase-2 call (expansion
# batches, judge passes, bespoke rewrites) share ONE pool, so this bounds
# total in-flight requests regardless of how many epics expand at once.
# Set to 1 for fully serial execution (env change only -- no code change).
# Default: 4
MIGRATION_PLAN_LLM_CONCURRENCY=4

# Inventory items (endpoints/tables) per phase-2 expansion LLM call.
# Default: 12
MIGRATION_PLAN_EXPANSION_BATCH_SIZE=12

# Behaviour-table ROW budget per corpus-derived endpoint story (SCL pipeline
# spec 7 -- corpus-derived spec planner). A controller group whose total rows
# (incl. its non-shared vertical residue) exceed the budget is split into
# consecutive-method "part N" slices. Tune on the first real corpus.
# Default: 40
SCL_STORY_ROW_BUDGET=40

# Contested-test circuit breakers (SCL pipeline spec 9 -- contested-test
# protocol). SCL_CONTEST_SPEC_THRESHOLD: a spec whose upheld-contest
# (quarantined) fraction of its shipped suite EXCEEDS this rate halts (a
# systematic extraction misread). SCL_CONTEST_RUN_THRESHOLD: a run whose
# aggregate quarantined fraction of all shipped tests EXCEEDS this rate halts.
# Thresholds are config values per the 2026-08-18 round-3 ruling.
# Defaults: 0.2 (spec) / 0.05 (run)
SCL_CONTEST_SPEC_THRESHOLD=0.2
SCL_CONTEST_RUN_THRESHOLD=0.05

# ============================================================================
# SYBASE SCHEMA HARVEST (Spec 3, 2026-08-04)
# ============================================================================

# POST /projects/:projectId/db-migration-packs/structural-harvest holds the
# HTTP connection while polling the metadata-only discovery run. These bound
# the poll loop; the route returns stage=scan_failed when the timeout expires.
# Defaults: poll every 5s, give up after 10 minutes.
DB_HARVEST_POLL_INTERVAL_MS=5000
DB_HARVEST_POLL_TIMEOUT_MS=600000
