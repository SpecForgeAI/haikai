          "current_landscape",
          "frontend_tech",
          "backend_tech",
          "data_storage",
          "infrastructure",
          "dev_tooling",
          "design_decisions",
          "constraints_review",
          "final_review"
        ]
      },
      "questions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "contextNeeds": ["mission", "architecture-baseline"],
  "persistence": "hub",
  "artifacts": [
    {
      "artifactId": "tech-stack",
      "filename": "TECH-STACK.MD",
