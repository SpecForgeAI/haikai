# API Proxy Targets for Local Development
# These environment variables configure where the Vite dev server proxies API requests.
# The proxy routes are defined in vite.config.ts.
#
# Chat API requests (/api/chat, /api/chat/stream) -> Gateway service
# All other API requests (/api/*) -> Architecture Model Service

VITE_MODEL_API_TARGET=http://localhost:8080
VITE_CHAT_API_TARGET=http://localhost:8081

# ============================================================================
# SHAPE-SPEC ROUTING (Spec 2026-01-30: Centralize Bearer Authentication)
# ============================================================================
# Shape-Spec streaming calls now route through the Gateway service.
# The Gateway handles Bearer authentication and proxies to the Shape-Spec service.
#
# Frontend calls: POST /api/v1/shape-spec/stream (via Gateway)
# Gateway proxies to: localhost:8000/api/v1/shape-spec/stream (with Bearer auth)
#
# VITE_SHAPE_SPEC_BASE_URL is DEPRECATED - Shape-Spec uses VITE_GATEWAY_BASE_URL
# which defaults to empty string (same-origin) for the Vite dev server proxy.
