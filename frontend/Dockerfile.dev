# Development Dockerfile for Frontend (Vite + React)
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files for dependency installation (layer caching)
COPY package.json package-lock.json ./

# Install dependencies
RUN npm install

# Note: Source files are NOT copied - they will be volume mounted for hot-reload

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server with host binding for Docker access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
