# Development Dockerfile for MCP Server
FROM node:20-alpine

# Set working directory
WORKDIR /app

# Copy package files for dependency installation (layer caching)
COPY package.json package-lock.json ./

# Install dependencies (includes devDependencies for tsx)
RUN npm ci

# Note: Source files are NOT copied - they will be volume mounted for hot-reload

# Expose MCP Server port
EXPOSE 8090

# Start the development server (uses tsx watch for hot-reload)
CMD ["npm", "run", "dev"]
