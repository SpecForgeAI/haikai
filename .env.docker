# Docker Development Environment Variables
# ==========================================
# Copy this file to .env before running docker-compose
#
# IMPORTANT: You must provide your own OPENAI_API_KEY before starting the stack

# Gateway Service
# ---------------
# REQUIRED: Provide your own OpenAI API key
OPENAI_API_KEY=your-openai-api-key-here
MCP_BASE_URL=http://mcp-server:8090
PORT=8081
ALLOWED_ORIGINS=http://localhost:5173

# MCP Server Service
# ------------------
ARCH_MODEL_SERVICE_BASE_URL=http://architecture-model-service:8080
MCP_PORT=8090

# Architecture Model Service (Spring Boot)
# ----------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/architecture_model
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=p05tgre5

# Frontend (Vite)
# ---------------
VITE_MODEL_API_TARGET=http://architecture-model-service:8080
VITE_CHAT_API_TARGET=http://gateway:8081

# PostgreSQL
# ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=p05tgre5
POSTGRES_DB=architecture_model
