      "schemaName": "Ledger",
      "procedureName": "SyncFromWarehouse",
      "routineKind": "procedure",
      "language": "TSQL",
      "executeAs": null,
      "functionKind": null,
      "assemblyName": null,
      "returnsType": null,
      "parameters": [
        {
          "name": "@AsOf",
