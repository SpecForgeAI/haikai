          "ordinal": 1,
          "userTypeName": null
        },
        {
          "name": "@RowsCopied",
          "dataType": "int",
          "maxLength": 4,
          "precision": 10,
          "scale": 0,
          "isOutput": true,
          "hasDefault": false,
          "isReadonly": false,
          "ordinal": 2,
          "userTypeName": null
        }
      ],
      "body": "CREATE PROCEDURE Ledger.SyncFromWarehouse\n  @AsOf date = NULL,\n  @RowsCopied int OUTPUT\nAS\nBEGIN\n  SET NOCOUNT ON;\n  INSERT INTO Ledger.Postings (PostedBy, IsVoided)\n  SELECT p.PostedBy, 0\n  FROM ReportingWarehouse.dbo.StagedPostings AS p\n  WHERE p.PostedOn >= ISNULL(@AsOf, '1900-01-01');\n\n  SELECT @RowsCopied = @@ROWCOUNT;\n\n  SELECT * FROM OPENQUERY(LEGACY_LINK, 'SELECT posting_id FROM legacy.postings');\n\n  MERGE Ledger.Postings AS tgt\n  USING (SELECT PostingID FROM Ops.SensorArchive) AS src\n  ON tgt.PostingID = src.PostingID\n  WHEN NOT MATCHED THEN INSERT (PostedBy, IsVoided) VALUES (N'sync', 0)\n  OUTPUT inserted.PostingID INTO @Inserted;\n\n  RETURN 0;\nEND;"
    },
