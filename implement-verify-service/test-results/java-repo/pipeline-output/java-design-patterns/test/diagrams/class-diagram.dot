digraph ClassDiagram {
    rankdir=TB;
    node [shape=record, fontsize=10];

    AbstractDocument [label="{AbstractDocument|+ documentProperties\l|+ AbstractDocument(Map<String, Object> properties)\l+ buildStringRepresentation()\l+ children(String key, Function<Map<String, Object>, T> childConstructor)\l+ get(String key)\l+ put(String key, Object value)\l+ toString()\l}"];
    App [label="{App|+ kingdom\l+ NUM_CREATURES\l+ logger\l|+ main(String[] args)\l+ createKingdom(final Kingdom.FactoryMaker.KingdomType kingdomType)\l+ main(String[] args)\l+ run()\l+ main(String[] args)\l+ run()\l+ main(String[] args)\l+ main(String[] args)\l}"];
    Car [label="{Car||+ Car(Map<String, Object> properties)\l}"];
    Part [label="{Part||+ Part(Map<String, Object> properties)\l}"];
    Property [label="{Property||}"];
    AbstractDocumentTest [label="{AbstractDocumentTest|+ KEY\l+ VALUE\l+ document\l|+ shouldHandleExceptionDuringConstruction()\l+ shouldIncludePropsInToString()\l+ shouldPutAndGetNestedDocument()\l+ shouldPutAndGetValue()\l+ shouldRetrieveChildren()\l+ shouldRetrieveEmptyStreamForNonExistingChildren()\l+ shouldUpdateExistingValue()\l}"];
    DocumentImplementation [label="{DocumentImplementation||}"];
    AppTest [label="{AppTest||+ shouldExecuteAppWithoutException()\l+ shouldExecuteApplicationWithoutException()\l+ shouldExecuteApplicationWithoutException()\l}"];
    DomainTest [label="{DomainTest|+ TEST_CAR_MODEL\l+ TEST_CAR_PRICE\l+ TEST_PART_MODEL\l+ TEST_PART_PRICE\l+ TEST_PART_TYPE\l|+ shouldConstructCar()\l+ shouldConstructPart()\l}"];
    ElfArmy [label="{ElfArmy|+ DESCRIPTION\l|+ getDescription()\l}"];
    ElfCastle [label="{ElfCastle|+ DESCRIPTION\l|+ getDescription()\l}"];
    ElfKing [label="{ElfKing|+ DESCRIPTION\l|+ getDescription()\l}"];
    ElfKingdomFactory [label="{ElfKingdomFactory||+ createArmy()\l+ createCastle()\l+ createKing()\l}"];
    FactoryMaker [label="{FactoryMaker||}"];
    Kingdom [label="{Kingdom|+ army\l+ castle\l+ king\l|}"];
    KingdomType [label="{KingdomType||}"];
    OrcArmy [label="{OrcArmy|+ DESCRIPTION\l|+ getDescription()\l}"];
    OrcCastle [label="{OrcCastle|+ DESCRIPTION\l|+ getDescription()\l}"];
    OrcKing [label="{OrcKing|+ DESCRIPTION\l|+ getDescription()\l}"];
    OrcKingdomFactory [label="{OrcKingdomFactory||+ createArmy()\l+ createCastle()\l+ createKing()\l}"];
    AbstractFactoryTest [label="{AbstractFactoryTest|+ app\l|+ verifyArmyCreation()\l+ verifyCastleCreation()\l+ verifyElfKingdomCreation()\l+ verifyKingCreation()\l+ verifyOrcKingdomCreation()\l}"];
    ActiveCreature [label="{ActiveCreature|+ logger\l+ name\l+ requests\l+ status\l+ thread\l|+ ActiveCreature(String name)\l+ eat()\l+ getStatus()\l+ kill(int status)\l+ name()\l+ roam()\l}"];
    Orc [label="{Orc||+ Orc(String name)\l}"];
    ActiveCreatureTest [label="{ActiveCreatureTest||+ executionTest()\l}"];
    Actor [label="{Actor|+ active\l+ actorId\l+ mailbox\l|+ onReceive(Message message)\l+ run()\l+ send(Message message)\l+ stop()\l}"];
    ActorSystem [label="{ActorSystem|+ actorRegister\l+ executor\l+ idCounter\l|+ getActorById(String actorId)\l+ shutdown()\l+ startActor(Actor actor)\l}"];
    ExampleActor [label="{ExampleActor|+ actorSystem\l+ receivedMessages\l|+ ExampleActor(ActorSystem actorSystem)\l+ onReceive(Message message)\l}"];
    ExampleActor2 [label="{ExampleActor2|+ actorSystem\l+ receivedMessages\l|+ ExampleActor2(ActorSystem actorSystem)\l+ onReceive(Message message)\l}"];
    Message [label="{Message|+ content\l+ senderId\l|}"];
    ActorModelTest [label="{ActorModelTest||+ testMainMethod()\l+ testMessagePassing()\l}"];
    ConfigureForDosVisitor [label="{ConfigureForDosVisitor||+ visit(Hayes hayes)\l+ visit(Zoom zoom)\l}"];
    ConfigureForUnixVisitor [label="{ConfigureForUnixVisitor||+ visit(Zoom zoom)\l}"];
    Hayes [label="{Hayes||+ accept(ModemVisitor modemVisitor)\l+ toString()\l}"];
    Zoom [label="{Zoom||+ accept(ModemVisitor modemVisitor)\l+ toString()\l}"];
    Document [label="{Document||}"];
    HasModel [label="{HasModel||}"];
    HasPrice [label="{HasPrice||}"];
    HasParts [label="{HasParts||}"];
    HasType [label="{HasType||}"];
    Runnable [label="{Runnable||}"];
    Army [label="{Army||}"];
    Castle [label="{Castle||}"];
    King [label="{King||}"];
    KingdomFactory [label="{KingdomFactory||}"];
    AllModemVisitor [label="{AllModemVisitor||}"];
    ZoomVisitor [label="{ZoomVisitor||}"];
    HayesVisitor [label="{HayesVisitor||}"];
    Modem [label="{Modem||}"];
    ModemVisitor [label="{ModemVisitor||}"];

    AbstractDocument -> Document [arrowhead=empty];
    Car -> AbstractDocument [arrowhead=empty];
    Car -> HasModel [arrowhead=empty];
    Car -> HasPrice [arrowhead=empty];
    Car -> HasParts [arrowhead=empty];
    HasModel -> Document [arrowhead=empty];
    HasParts -> Document [arrowhead=empty];
    HasPrice -> Document [arrowhead=empty];
    HasType -> Document [arrowhead=empty];
    Part -> AbstractDocument [arrowhead=empty];
    Part -> HasType [arrowhead=empty];
    Part -> HasModel [arrowhead=empty];
    Part -> HasPrice [arrowhead=empty];
    DocumentImplementation -> AbstractDocument [arrowhead=empty];
    App -> Runnable [arrowhead=empty];
    ElfArmy -> Army [arrowhead=empty];
    ElfCastle -> Castle [arrowhead=empty];
    ElfKing -> King [arrowhead=empty];
    ElfKingdomFactory -> KingdomFactory [arrowhead=empty];
    OrcArmy -> Army [arrowhead=empty];
    OrcCastle -> Castle [arrowhead=empty];
    OrcKing -> King [arrowhead=empty];
    OrcKingdomFactory -> KingdomFactory [arrowhead=empty];
    App -> Runnable [arrowhead=empty];
    Orc -> ActiveCreature [arrowhead=empty];
    Actor -> Runnable [arrowhead=empty];
    ExampleActor -> Actor [arrowhead=empty];
    ExampleActor2 -> Actor [arrowhead=empty];
    AllModemVisitor -> ZoomVisitor [arrowhead=empty];
    AllModemVisitor -> HayesVisitor [arrowhead=empty];
    ConfigureForDosVisitor -> AllModemVisitor [arrowhead=empty];
    ConfigureForUnixVisitor -> ZoomVisitor [arrowhead=empty];
    Hayes -> Modem [arrowhead=empty];
    HayesVisitor -> ModemVisitor [arrowhead=empty];
    Zoom -> Modem [arrowhead=empty];
}
