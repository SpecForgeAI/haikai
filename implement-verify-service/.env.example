# LLM Provider Configuration
# Supported providers: openai, anthropic, azure, custom
LLM_PROVIDER=anthropic

# API Keys (set the one for your provider)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# Model Configuration
# For OpenAI: gpt-5.4, gpt-5.4-mini, gpt-5.4-nano
# For Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229, claude-sonnet-4-20250514
# For Azure: your-deployment-name
LLM_MODEL=gpt-5.4

# Custom API Configuration (for custom providers)
CUSTOM_API_BASE_URL=https://api.example.com/v1
CUSTOM_API_KEY=your_custom_api_key_here

# Azure-specific Configuration
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=your-deployment-name

# Repository Access Tokens
GITHUB_TOKEN=your_github_token_here
GITLAB_TOKEN=your_gitlab_token_here
BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_bitbucket_app_password

# Processing Configuration
MAX_FILE_SIZE_KB=500
MAX_CONCURRENT_FILES=5
BATCH_SIZE=10

# Output Configuration
OUTPUT_DIR=./output
INCLUDE_SOURCE_REFERENCES=true

# Chat Executor Backend (required)
# Supported: kiro, claude
# kiro = uses kiro-cli (SSO auth, no API key needed)
# claude = uses Claude Code CLI (needs ANTHROPIC_API_KEY)
CHAT_EXECUTOR=kiro

# Workspace Configuration
API_WORKSPACE_DIR=./api_workspace
STANDARDS_API_KEY=changeit

# Async Job Queue Configuration
# -------------------------------
# Path to SQLite database for job queue (default: {API_WORKSPACE_DIR}/jobs.db)
JOBS_DB_PATH=./api_workspace/jobs.db

# Worker identifier for background job processing (default: worker-1)
WORKER_ID=worker-1

# Directory for orchestration logs (default: {API_WORKSPACE_DIR}/logs/orchestration)
ORCHESTRATION_LOG_DIR=./api_workspace/logs/orchestration

# Rate-limit (HTTP 429) backoff
# -------------------------------
# How long (seconds) to keep retrying with exponential backoff when the Anthropic
# API returns 429/529 before giving up and failing the call. Backoff is exponential
# (2s x2, capped at 60s/sleep, full jitter, honors Retry-After); this is the total
# wall-clock budget. Raise it to ride out longer rate-limit windows. Default: 600 (10 min).
RATE_LIMIT_MAX_ELAPSED_SECONDS=600
