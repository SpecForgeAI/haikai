# Docker Development Environment Variables
# ==========================================
# Copy this file to .env before running docker-compose
#
# IMPORTANT: You must provide your own API keys before starting the stack

# Standards Extractor API Service
# --------------------------------
# REQUIRED: Provide your own API key for authentication
STANDARDS_API_KEY=changeit
# API workspace directory (inside container)
API_WORKSPACE_DIR=/app/workspace

# LLM Provider Configuration
# ---------------------------
# REQUIRED: Choose your LLM provider
# Supported providers: openai, anthropic, azure, custom
LLM_PROVIDER=openai

# REQUIRED: Specify the model to use
# For OpenAI: gpt-5.4, gpt-5.4-mini, gpt-5.4-nano
# For Anthropic: claude-sonnet-4-20250514, claude-3-opus-20240229
# For Azure: your-deployment-name
LLM_MODEL=gpt-5.4

# API Keys
# --------
# REQUIRED: Provide API key for your chosen provider

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (REQUIRED for Haikai Orchestrator with Claude CLI)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Azure OpenAI API Key (required if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your-azure-api-key-here

# Custom API Key (required if LLM_PROVIDER=custom)
CUSTOM_API_KEY=your-custom-api-key-here

# Azure-specific Configuration
# -----------------------------
# Required only if using Azure OpenAI
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=your-deployment-name

# Custom API Configuration
# -------------------------
# Required only if using custom LLM provider
CUSTOM_API_BASE_URL=https://api.example.com/v1

# Git Integration (Optional)
# ---------------------------
# Provide tokens if you need to fetch code from private repositories

# Repository Access Tokens
GITHUB_TOKEN=your-github-token-here

# GitHub API Query Token (for GitHub API access)
GITHUB_REPO_QUERY_API_KEY=

# GitLab Personal Access Token
GITLAB_TOKEN=

# Bitbucket Credentials
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# Git Integration (V2 endpoints)
# --------------------------------
# Required for v2 endpoints. Set GIT_PROVIDER to enable git integration.
GIT_PROVIDER=github
GIT_DEFAULT_BRANCH=main
GIT_AUTO_PUSH=true
GIT_AUTO_PR=true

# Processing Configuration
# -------------------------
# Optional: Tune performance and resource usage

# Maximum file size to process (in KB)
MAX_FILE_SIZE_KB=500

# Maximum number of files to process concurrently
MAX_CONCURRENT_FILES=5

# Batch size for processing operations
BATCH_SIZE=10

# Extraction Limits (for testing/development)
# Maximum files to analyze in extraction stages (empty or not set = no limit)
STANDARD_EXTRACTION_MAX_FILES=10

# Output Configuration
# --------------------
# Optional: Configure output behavior

# Output directory for generated files
OUTPUT_DIR=./output

# Include source code references in generated standards
INCLUDE_SOURCE_REFERENCES=true

# Async Job Queue Configuration
# -------------------------------
# Path to SQLite database for job queue (default: {API_WORKSPACE_DIR}/jobs.db)
JOBS_DB_PATH=/app/workspace/jobs.db

# Worker identifier for background job processing (default: worker-1)
WORKER_ID=worker-1

# Directory for orchestration logs (default: {API_WORKSPACE_DIR}/logs/orchestration)
ORCHESTRATION_LOG_DIR=/app/workspace/logs/orchestration

# Path Configuration
# -------------------
# Virtual environment path (for container)
VIRTUAL_ENV_PATH=/app/.venv

# Node modules path
NODE_PATH=/app/node_modules

# Claude/Haikai profiles path
CLAUDE_PROFILES_PATH=/app/haikai-profiles

# --- Kiro model pinning (Robustness R1, 2026-08-05) --------------------------
# Every kiro-cli spawn pins this model (src/chat/model_pinning.py). Empty or
# "auto" disables pinning for that slot.
KIRO_CHAT_MODEL=claude-opus-5
# Fallback when the primary keeps transiently failing: after
# KIRO_MODEL_FALLBACK_THRESHOLD (default 3) transient upstream failures in
# one run, spawns pin this instead (src/chat/transient_failure.py).
KIRO_CHAT_MODEL_ALTERNATIVE=claude-opus-4.8
