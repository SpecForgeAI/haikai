"""Tests for endpoint and data movement extraction across all language extractors.

Covers: Python (FastAPI), Java (Spring), TypeScript (Express+Prisma),
Go (net/http+sql), C# (ASP.NET+EFCore).
"""
import sys
import pytest

# Reset endpoint config caches before each test module run
from src.ast.extractors.endpoint_config import reset_caches
reset_caches()


# ---------------------------------------------------------------------------
# Python (FastAPI / Flask / Celery)
# ---------------------------------------------------------------------------

class TestPythonEndpoints:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.python import PythonExtractor
        reset_caches()
        self.ext = PythonExtractor()

    def test_fastapi_get_post(self):
        source = b'''
from fastapi import FastAPI
app = FastAPI()

@app.get("/users/{user_id}")
async def get_user(user_id: int):
    return {"user_id": user_id}

@app.post("/users")
async def create_user(user: dict):
    return user
'''
        eps = self.ext.extract_endpoints(source, "api.py")
        assert len(eps) == 2
        assert eps[0].operation == "GET"
        assert eps[0].path == "/users/{user_id}"
        assert eps[0].handler_method == "get_user"
        assert eps[0].framework == "fastapi"
        assert eps[1].operation == "POST"
        assert eps[1].path == "/users"

    def test_fastapi_router(self):
        source = b'''
from fastapi import APIRouter
router = APIRouter()

@router.put("/items/{item_id}")
def update_item(item_id: int):
    pass

@router.delete("/items/{item_id}")
def delete_item(item_id: int):
    pass
'''
        eps = self.ext.extract_endpoints(source, "routes.py")
        assert len(eps) == 2
        assert eps[0].operation == "PUT"
        assert eps[1].operation == "DELETE"

    def test_no_endpoints_in_plain_code(self):
        source = b'''
def helper():
    return 42

class Service:
    def process(self):
        pass
'''
        eps = self.ext.extract_endpoints(source, "service.py")
        assert len(eps) == 0


class TestPythonDataMovements:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.python import PythonExtractor
        reset_caches()
        self.ext = PythonExtractor()

    def test_requests_http_calls(self):
        source = b'''
import requests

class OrderService:
    def create_order(self):
        resp = requests.post("http://api.example.com/orders", json={})
        data = requests.get("http://api.example.com/users/1")
'''
        dms = self.ext.extract_interactions(source, "services.py")
        assert len(dms) == 2
        assert dms[0].mechanism == "requests"
        assert dms[0].target_type == "HTTP_SERVICE"
        assert dms[0].target == "http://api.example.com/orders"
        assert dms[1].target == "http://api.example.com/users/1"

    def test_sqlalchemy_session(self):
        source = b'''
class UserRepo:
    def get_user(self, session, user_id):
        return session.query(User).filter_by(id=user_id).first()

    def save_user(self, session, user):
        session.add(user)
        session.commit()
'''
        dms = self.ext.extract_interactions(source, "repo.py")
        assert len(dms) >= 2
        mechanisms = [d.mechanism for d in dms]
        assert "SQLAlchemy" in mechanisms

    def test_no_movements_in_plain_code(self):
        source = b'''
def calculate(x, y):
    return x + y
'''
        dms = self.ext.extract_interactions(source, "math.py")
        assert len(dms) == 0


# ---------------------------------------------------------------------------
# Java (Spring)
# ---------------------------------------------------------------------------

class TestJavaEndpoints:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.java import JavaExtractor
        reset_caches()
        self.ext = JavaExtractor()

    def test_spring_controller(self):
        source = b'''
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/orders")
public class OrderController {

    @GetMapping("/{id}")
    public Order getOrder(@PathVariable Long id) {
        return orderService.findById(id);
    }

    @PostMapping
    public Order createOrder(@RequestBody Order order) {
        return orderService.save(order);
    }

    @DeleteMapping("/{id}")
    public void deleteOrder(@PathVariable Long id) {
        orderService.deleteById(id);
    }
}
'''
        eps = self.ext.extract_endpoints(source, "OrderController.java")
        assert len(eps) == 3
        ops = [e.operation for e in eps]
        assert "GET" in ops
        assert "POST" in ops
        assert "DELETE" in ops
        assert all(e.framework == "spring" for e in eps)
        assert all(e.handler_class == "OrderController" for e in eps)

    def test_kafka_listener(self):
        source = b'''
import org.springframework.kafka.annotation.KafkaListener;

public class OrderListener {
    @KafkaListener(topics = "order.created")
    public void onOrderCreated(String message) {
        processOrder(message);
    }
}
'''
        eps = self.ext.extract_endpoints(source, "OrderListener.java")
        assert len(eps) == 1
        assert eps[0].type == "MQ_CONSUMER"
        assert eps[0].protocol == "KAFKA"

    def test_scheduled_job(self):
        source = b'''
import org.springframework.scheduling.annotation.Scheduled;

public class ReportJob {
    @Scheduled(cron = "0 0 * * *")
    public void generateReport() {
        doReport();
    }
}
'''
        eps = self.ext.extract_endpoints(source, "ReportJob.java")
        assert len(eps) == 1
        assert eps[0].type == "SCHEDULED"
        assert eps[0].protocol == "CRON"


class TestJavaDataMovements:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.java import JavaExtractor
        reset_caches()
        self.ext = JavaExtractor()

    def test_rest_template(self):
        source = b'''
public class UserService {
    private RestTemplate restTemplate;

    public User getUser(Long id) {
        return restTemplate.getForObject("http://user-service/users/" + id, User.class);
    }
}
'''
        dms = self.ext.extract_interactions(source, "UserService.java")
        assert len(dms) == 1
        assert dms[0].mechanism == "RestTemplate"
        assert dms[0].target_type == "HTTP_SERVICE"

    def test_jpa_repository(self):
        source = b'''
public class OrderService {
    private OrderRepository orderRepository;

    public Order findOrder(Long id) {
        return orderRepository.findById(id);
    }

    public void saveOrder(Order order) {
        orderRepository.save(order);
    }
}
'''
        dms = self.ext.extract_interactions(source, "OrderService.java")
        assert len(dms) == 2
        dirs = {d.direction for d in dms}
        assert "READ" in dirs
        assert "WRITE" in dirs
        assert all(d.mechanism == "JPA" for d in dms)


# ---------------------------------------------------------------------------
# TypeScript (Express + Prisma)
