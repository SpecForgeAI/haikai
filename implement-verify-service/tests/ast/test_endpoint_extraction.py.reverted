class TestCSharpEndpoints:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.csharp import CSharpExtractor
        reset_caches()
        self.ext = CSharpExtractor()

    def test_aspnet_attributes(self):
        source = b'''
using Microsoft.AspNetCore.Mvc;

[ApiController]
public class ProductsController : ControllerBase
{
    [HttpGet("{id}")]
    public IActionResult GetProduct(int id) { return Ok(); }

    [HttpPost]
    public IActionResult CreateProduct(Product p) { return Created(); }
}
'''
        eps = self.ext.extract_endpoints(source, "ProductsController.cs")
        assert len(eps) == 2
        ops = [e.operation for e in eps]
        assert "GET" in ops
        assert "POST" in ops
        assert all(e.framework == "aspnet" for e in eps)

    def test_minimal_api(self):
        source = b'''
var app = WebApplication.Create();
app.MapGet("/hello", () => "Hello");
app.MapPost("/submit", (Data d) => Results.Ok(d));
'''
        eps = self.ext.extract_endpoints(source, "Program.cs")
        assert len(eps) == 2
        paths = [e.path for e in eps]
        assert "/hello" in paths
        assert "/submit" in paths


class TestCSharpDataMovements:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.csharp import CSharpExtractor
        reset_caches()
        self.ext = CSharpExtractor()

    def test_ef_core_and_httpclient(self):
        source = b'''
public class ProductsController : ControllerBase
{
    private readonly AppDbContext _context;
    private readonly HttpClient _httpClient;

    public IActionResult GetProduct(int id)
    {
        var product = _context.Products.Find(id);
        _context.SaveChanges();
        var data = _httpClient.GetAsync("http://api.example.com/data");
        return Ok(product);
    }
}
'''
        dms = self.ext.extract_interactions(source, "Controller.cs")
        assert len(dms) == 3
        mechs = {d.mechanism for d in dms}
        assert "EFCore" in mechs
        assert "HttpClient" in mechs


# ---------------------------------------------------------------------------
# Store writers
# ---------------------------------------------------------------------------

class TestStoreWriters:
    def test_write_endpoints_file(self, tmp_path):
        from src.ast.models import StructuralAnalysis, EndpointInfo

        analyses = {
            "api.py": StructuralAnalysis(
                file_path="api.py",
                language="python",
                endpoints=[
                    EndpointInfo(
                        type="REST", path="/users", operation="GET",
                        handler_class="", handler_method="get_users",
                        file="api.py", line=10, framework="fastapi",
                    ),
                ],
            ),
        }

        from src.ast.store import FileStore
        store = FileStore(base_path=str(tmp_path))
        store._project_root = ""
        store.write_endpoints(tmp_path, analyses)

        content = (tmp_path / "_endpoints.txt").read_text()
        assert "REST" in content
        assert "/users" in content
        assert "GET" in content
        assert "fastapi" in content

    def test_write_interactions_file(self, tmp_path):
        from src.ast.models import StructuralAnalysis, InteractionInfo

        analyses = {
            "service.py": StructuralAnalysis(
                file_path="service.py",
                language="python",
                interactions=[
                    InteractionInfo(
                        source_class="OrderService", source_method="create",
                        target="http://api.example.com/orders",
                        target_type="HTTP_SERVICE", direction="REQUEST_RESPONSE",
                        mechanism="requests", file="service.py", line=15,
                    ),
                ],
            ),
        }

        from src.ast.store import FileStore
        store = FileStore(base_path=str(tmp_path))
        store._project_root = ""
        store.write_interactions(tmp_path, analyses)

        content = (tmp_path / "_interactions.txt").read_text()
        assert "HTTP_SERVICE" in content
        assert "requests" in content
        assert "OrderService" in content

    def test_write_extraction_meta(self, tmp_path):
        from src.ast.models import StructuralAnalysis, EndpointInfo, InteractionInfo

        analyses = {
            "api.py": StructuralAnalysis(
                file_path="api.py",
                language="python",
                endpoints=[
                    EndpointInfo(
                        type="REST", path="/users", operation="GET",
                        handler_class="", handler_method="get_users",
                        file="api.py", line=10, framework="fastapi",
                    ),
                    EndpointInfo(
                        type="REST", path="/users", operation="POST",
                        handler_class="", handler_method="create_user",
                        file="api.py", line=20, framework="fastapi",
                    ),
                ],
                interactions=[
                    InteractionInfo(
                        source_class="", source_method="get_users",
                        target="db", target_type="DATABASE",
                        direction="READ", mechanism="SQLAlchemy",
                        file="api.py", line=12,
                    ),
                ],
            ),
        }

        from src.ast.store import FileStore
        import yaml
        store = FileStore(base_path=str(tmp_path))
        store.write_extraction_meta(tmp_path, analyses)

        content = (tmp_path / "_extraction_meta.yaml").read_text()
        meta = yaml.safe_load(content)
        assert meta["extraction"]["stats"]["endpoints_found"] == 2
        assert meta["extraction"]["stats"]["interactions_found"] == 1
        assert len(meta["extraction"]["frameworks_detected"]) == 1
        assert meta["extraction"]["frameworks_detected"][0]["name"] == "fastapi"


# ---------------------------------------------------------------------------
# Config loader
# ---------------------------------------------------------------------------

class TestEndpointConfig:
    def test_load_endpoint_patterns(self):
        reset_caches()
        from src.ast.extractors.endpoint_config import load_endpoint_patterns
        patterns = load_endpoint_patterns()
        assert "fastapi" in patterns
        assert "spring" in patterns
        assert "express" in patterns
        assert "aspnet" in patterns

    def test_get_endpoint_frameworks_filters_by_language(self):
        reset_caches()
        from src.ast.extractors.endpoint_config import get_endpoint_frameworks
        py = get_endpoint_frameworks("python")
        assert "fastapi" in py
        assert "spring" not in py

        java = get_endpoint_frameworks("java")
        assert "spring" in java
        assert "fastapi" not in java

    def test_get_interaction_patterns_filters_by_language(self):
        reset_caches()
        from src.ast.extractors.endpoint_config import get_interaction_patterns
        py = get_interaction_patterns("python")
        assert len(py) > 0
        assert all(True for p in py)  # all loaded

        go = get_interaction_patterns("go")
        assert len(go) > 0
        go_mechs = {p["mechanism"] for p in go}
        assert "net/http" in go_mechs or "database/sql" in go_mechs
