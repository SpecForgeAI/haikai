class TestTypeScriptEndpoints:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.typescript import TypeScriptExtractor
        reset_caches()
        self.ext = TypeScriptExtractor()

    def test_express_routes(self):
        source = b'''
import express from "express";
const router = express.Router();

router.get("/users", async (req, res) => {
    res.json(await getUsers());
});

router.post("/users", async (req, res) => {
    res.json(await createUser(req.body));
});

router.delete("/users/:id", async (req, res) => {
    res.sendStatus(204);
});
'''
        eps = self.ext.extract_endpoints(source, "routes.ts")
        assert len(eps) == 3
        ops = [e.operation for e in eps]
        assert "GET" in ops
        assert "POST" in ops
        assert "DELETE" in ops
        assert all(e.framework == "express" for e in eps)

    def test_no_endpoints_in_utility(self):
        source = b'''
export function formatDate(d: Date): string {
    return d.toISOString();
}
'''
        eps = self.ext.extract_endpoints(source, "utils.ts")
        assert len(eps) == 0


class TestTypeScriptDataMovements:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.typescript import TypeScriptExtractor
        reset_caches()
        self.ext = TypeScriptExtractor()

    def test_fetch_and_prisma(self):
        source = b'''
async function getExternalData() {
    const resp = await fetch("https://api.example.com/data");
    const users = await prisma.user.findMany();
    await prisma.order.create({ data: { amount: 100 } });
}
'''
        dms = self.ext.extract_interactions(source, "service.ts")
        assert len(dms) == 3
        mechs = [d.mechanism for d in dms]
        assert "fetch" in mechs
        assert "Prisma" in mechs

    def test_axios(self):
        source = b'''
import axios from "axios";

async function postData() {
    await axios.post("https://api.example.com/submit", { key: "value" });
}
'''
        dms = self.ext.extract_interactions(source, "client.ts")
        assert len(dms) == 1
        assert dms[0].mechanism == "axios"
        assert dms[0].target == "https://api.example.com/submit"


