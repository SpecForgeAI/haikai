class TestGoEndpoints:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.go import GoExtractor
        reset_caches()
        self.ext = GoExtractor()

    def test_http_handlefunc(self):
        source = b'''
package main

import "net/http"

func main() {
    http.HandleFunc("/health", healthHandler)
    http.HandleFunc("/api/users", usersHandler)
}
'''
        eps = self.ext.extract_endpoints(source, "main.go")
        assert len(eps) == 2
        paths = [e.path for e in eps]
        assert "/health" in paths
        assert "/api/users" in paths
        assert all(e.framework == "go_net_http" for e in eps)


class TestGoDataMovements:
    @pytest.fixture(autouse=True)
    def setup(self):
        from src.ast.extractors.go import GoExtractor
        reset_caches()
        self.ext = GoExtractor()

    def test_http_get_and_sql(self):
        source = b'''
package main

import (
    "net/http"
    "database/sql"
)

func fetchData(db *sql.DB) {
    rows, _ := db.Query("SELECT * FROM users")
    resp, _ := http.Get("http://other-service/data")
}
'''
        dms = self.ext.extract_interactions(source, "main.go")
        assert len(dms) == 2
        types = {d.target_type for d in dms}
        assert "DATABASE" in types
        assert "HTTP_SERVICE" in types


