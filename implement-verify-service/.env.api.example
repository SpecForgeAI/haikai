# Standards Extractor API Configuration

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Security
STANDARDS_API_KEY=your-secret-api-key-here

# Workspace Directory (use forward slashes for cross-platform compatibility)
# Windows example: API_WORKSPACE_DIR=C:/Projects/api_workspace
# Unix/Linux/macOS example: API_WORKSPACE_DIR=/home/user/api_workspace
API_WORKSPACE_DIR=/home/ubuntu/api_workspace

# Log Directories (optional - defaults to subdirectories within API_WORKSPACE_DIR)
# LOG_DIR: General API logs (default: {API_WORKSPACE_DIR}/logs)
# ORCHESTRATION_LOG_DIR: Haikai orchestration logs (default: {API_WORKSPACE_DIR}/logs/orchestration)
# LOG_DIR=/home/ubuntu/api_workspace/logs
# ORCHESTRATION_LOG_DIR=/home/ubuntu/api_workspace/logs/orchestration

# OpenAI Configuration (required for LLM operations)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (required for Haikai orchestration)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Chat Executor Backend (required)
# kiro = uses kiro-cli (SSO auth, no API key needed)
# claude = uses Claude Code CLI (needs ANTHROPIC_API_KEY above)
CHAT_EXECUTOR=kiro

# Async Job Queue Configuration
# -------------------------------
# Path to SQLite database for job queue (default: {API_WORKSPACE_DIR}/jobs.db)
JOBS_DB_PATH=/home/ubuntu/api_workspace/jobs.db

# Worker identifier for background job processing (default: worker-1)
WORKER_ID=worker-1
