<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sybase Discovery Sidecar.
  Spec: 2026-05-16 Database Discovery Packs - Task Group 4.

  A small JVM HTTP service that wraps a Sybase JDBC driver and exposes a
  minimal HTTP surface so the discovery-service (Node) can run read-only
  introspection + SELECT-only queries against a live Sybase ASE instance
  without pulling the JDBC driver into the Node runtime.

  Driver choice (revised 2026-05-17):
    * Both jTDS and jConnect can be wired in. The runtime SybaseQueryService
      picks per-request based on the `driver` field (auto | jtds | jconnect),
      so different Sybase server builds can be served by whichever driver
      they accept.
    * jTDS (net.sourceforge.jtds:jtds:1.3.1) is a regular Maven Central
      dependency. Freely redistributable (LGPL); works for many Sybase ASE
      servers; first-attempt default in auto mode.
    * jConnect (com.sybase.jdbc4:jconn4:7.07) is SAP-supplied; not on Maven
      Central. The jar must be placed at sybase-discovery-sidecar/lib/
      jconn4.jar by the operator. When the file exists the `jconnect-driver`
      profile auto-activates and the system-scope dep is added to the build;
      when absent the build still succeeds and the runtime falls back to a
      jTDS-only auto path.
    * The Java code in service/ never references jconn4 classes directly;
      it loads them via reflection so the source compiles either way.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>sybase-discovery-sidecar</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Sybase Discovery Sidecar</name>
    <description>HTTP sidecar wrapping Sybase JDBC for the discovery-service Sybase pack.</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web layer: minimal Spring Boot starter for the HTTP endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation for incoming request payloads. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          jTDS Sybase ASE JDBC driver. LGPL, on Maven Central. First-attempt
          driver in auto mode. Older Sybase ASE servers (commonly pre-15.7)
          accept jTDS happily.
        -->
        <dependency>
            <groupId>net.sourceforge.jtds</groupId>
            <artifactId>jtds</artifactId>
            <version>1.3.1</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.sybasesidecar.SidecarApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          jConnect runtime profile. Auto-activates when lib/jconn4.jar is
          present in the project directory. The jar is supplied by the
          operator (see README) and is NOT under version control.

          When active:
            * jconn4 is added as a system-scope dep so the compile + runtime
              classpath picks it up.
            * The Spring Boot fat-jar repackage includes the system-scope
              jar so a packaged sidecar can run without an external lib dir.
        -->
        <profile>
            <id>jconnect-driver</id>
            <activation>
                <file>
                    <exists>${project.basedir}/lib/jconn4.jar</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.sybase.jdbc4</groupId>
                    <artifactId>jconn4</artifactId>
                    <version>7.07</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/lib/jconn4.jar</systemPath>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <includeSystemScope>true</includeSystemScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
